{
  "name": "@cobusgreyling/loop-context",
  "version": "1.3.0",
  "description": "Stateful memory manager for agent loops, positioned in this fork to prefer GitHub API-only repository metadata ingestion for audit/context workflows: accept owner/repo with token-backed API access, summarize only the metadata needed for analysis, avoid local checkout execution by default, and follow a minimal-permission GitHub token contract.",
  "type": "module",
  "main": "dist/context-manager.js",
  "exports": {
    ".": "./dist/context-manager.js"
  },
  "bin": {
    "loop-context": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "loop-engineering",
    "ai-agents",
    "coding-agents",
    "context-management",
    "circuit-breaker",
    "memory",
    "claude-code",
    "grok",
    "devtools",
    "github-api-only",
    "repository-metadata",
    "minimal-permissions",
    "github-token"
  ],
  "author": "Cobus Greyling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitsudolab/loop-engineering.git",
    "directory": "tools/loop-context"
  },
  "homepage": "https://github.com/mitsudolab/loop-engineering",
  "bugs": {
    "url": "https://github.com/mitsudolab/loop-engineering/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "loopEngineering": {
    "githubApi": {
      "usesGitHub": true,
      "tokenEnvVar": "GITHUB_TOKEN",
      "minimumPermissions": {
        "metadata": "read",
        "contents": "read-when-required"
      },
      "mustNotPersistOrEmit": [
        "raw-github-token",
        "authorization-headers",
        "full-raw-api-payloads-when-derived-context-is-sufficient",
        "unnecessary-personal-data"
      ],
      "contractDoc": "../../docs/github-token-contract.md"
    }
  },
  "dependencies": {
    "@cobusgreyling/loop-cost": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
