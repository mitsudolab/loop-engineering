{
  "name": "@cobusgreyling/loop-audit",
  "version": "1.6.1",
  "description": "Loop engineering readiness auditor for GitHub API-only review flows. Compute Loop Readiness Score (L0-L3), detect activity, and get actionable suggestions without requiring local runtime changes to the target repository.",
  "type": "module",
  "bin": {
    "loop-audit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/auditor.test.mjs",
    "prepublishOnly": "npm test",
    "start": "node dist/cli.js",
    "audit": "npm run build && node dist/cli.js",
    "audit:suggest": "npm run build && node dist/cli.js . --suggest",
    "demo": "bash ../../scripts/before-after-demo.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "loop-engineering",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "grok",
    "opencode",
    "readiness",
    "audit",
    "github-api-only",
    "backend-core-review"
  ],
  "author": "Cobus Greyling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitsudolab/loop-engineering.git",
    "directory": "tools/loop-audit"
  },
  "homepage": "https://github.com/mitsudolab/loop-engineering/tree/main/tools/loop-audit",
  "bugs": {
    "url": "https://github.com/mitsudolab/loop-engineering/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2"
  }
}
