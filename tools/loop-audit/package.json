{
  "name": "@cobusgreyling/loop-audit",
  "version": "1.6.1",
  "description": "Loop engineering readiness auditor for a single GitHub API-only ingestion mode: accept owner/repo with token-backed API access, fetch only repository metadata needed for readiness analysis, avoid requiring local runtime changes to the target repository, and operate with a minimal-permission GitHub token contract.",
  "type": "module",
  "bin": {
    "loop-audit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/auditor.test.mjs",
    "prepublishOnly": "npm test",
    "start": "node dist/cli.js",
    "audit": "npm run build && node dist/cli.js",
    "audit:suggest": "npm run build && node dist/cli.js . --suggest",
    "demo": "bash ../../scripts/before-after-demo.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "loop-engineering",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "grok",
    "opencode",
    "readiness",
    "audit",
    "github-api-only",
    "repository-metadata",
    "minimal-permissions",
    "github-token",
    "backend-core-review",
    "package-boundaries"
  ],
  "author": "Cobus Greyling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitsudolab/loop-engineering.git",
    "directory": "tools/loop-audit"
  },
  "homepage": "https://github.com/mitsudolab/loop-engineering/tree/main/tools/loop-audit",
  "bugs": {
    "url": "https://github.com/mitsudolab/loop-engineering/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "loopEngineering": {
    "packageScope": {
      "role": "github-api-audit-ingestion",
      "publishingModel": "publish-from-tools-directory-only",
      "workspaceRootIsPublishTarget": false
    },
    "githubApi": {
      "usesGitHub": true,
      "tokenEnvVar": "GITHUB_TOKEN",
      "expectedEnvironmentVariables": [
        "GITHUB_TOKEN"
      ],
      "preferredTokenTypes": [
        "fine-grained-personal-access-token",
        "github-app-installation-token"
      ],
      "classicPatFallbackScopes": {
        "publicRepositories": "public_repo",
        "privateRepositories": "repo"
      },
      "minimumPermissions": {
        "metadata": "read",
        "contents": "read-when-required"
      },
      "requiredRepositoryPermissions": {
        "fineGrainedPersonalAccessToken": {
          "metadata": "read",
          "contents": "read-when-required"
        },
        "githubAppInstallationToken": {
          "metadata": "read",
          "contents": "read-when-required"
        }
      },
      "apiOnlyBoundary": {
        "acceptedInputs": [
          "owner/repo",
          "repository-url-resolved-to-owner-repo"
        ],
        "forbiddenActions": [
          "git-push",
          "pull-request-writes",
          "issue-or-comment-writes",
          "workflow-or-settings-mutations",
          "secret-management"
        ],
        "resultHandling": [
          "emit-derived-findings-and-summaries",
          "avoid-persisting-full-raw-api-responses-by-default",
          "keep-token-ownership-inside-the-audit-step"
        ]
      }
    }
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^5.0.0"
  }
}
