{
  "name": "@cobusgreyling/loop-audit",
  "version": "1.6.1",
  "description": "Loop engineering readiness auditor for a single GitHub API-only ingestion mode: accept owner/repo with token-backed API access, fetch only repository metadata needed for readiness analysis, avoid requiring local runtime changes to the target repository, and operate with a minimal-permission GitHub token contract.",
  "type": "module",
  "bin": {
    "loop-audit": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/auditor.test.mjs",
    "prepublishOnly": "npm test",
    "start": "node dist/cli.js",
    "audit": "npm run build && node dist/cli.js",
    "audit:suggest": "npm run build && node dist/cli.js . --suggest",
    "demo": "bash ../../scripts/before-after-demo.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "loop-engineering",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "codex",
    "grok",
    "opencode",
    "readiness",
    "audit",
    "github-api-only",
    "repository-metadata",
    "minimal-permissions",
    "github-token",
    "backend-core-review"
  ],
  "author": "Cobus Greyling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitsudolab/loop-engineering.git",
    "directory": "tools/loop-audit"
  },
  "homepage": "https://github.com/mitsudolab/loop-engineering/tree/main/tools/loop-audit",
  "bugs": {
    "url": "https://github.com/mitsudolab/loop-engineering/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "loopEngineering": {
    "githubApi": {
      "usesGitHub": true,
      "tokenEnvVar": "GITHUB_TOKEN",
      "minimumPermissions": {
        "metadata": "read",
        "contents": "read-when-required"
      },
      "mustNotPersistOrEmit": [
        "raw-github-token",
        "authorization-headers",
        "full-raw-api-payloads-when-derived-findings-are-sufficient",
        "unnecessary-personal-data"
      ],
      "contractDoc": "../../docs/github-token-contract.md"
    }
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2"
  }
}
