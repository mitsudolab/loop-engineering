{
  "name": "@cobusgreyling/loop-cost",
  "version": "1.1.0",
  "description": "Standalone CLI for estimating token budgets and daily costs for Loop Engineering usage patterns from bundled registry data, without requiring installation of the private monorepo root package.",
  "type": "module",
  "bin": {
    "loop-cost": "dist/cli.js"
  },
  "files": [
    "dist",
    "registry.json",
    "README.md"
  ],
  "scripts": {
    "bundle": "node scripts/bundle-registry.mjs",
    "build": "npm run bundle && tsc",
    "test": "npm run build && node --test test/estimator.test.mjs",
    "prepublishOnly": "npm test",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "loop-engineering",
    "ai-agents",
    "coding-agents",
    "token-budget",
    "cost-estimate",
    "claude-code",
    "grok",
    "budget",
    "devtools",
    "cli-tools",
    "standalone-cli",
    "package-boundaries"
  ],
  "author": "Cobus Greyling",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitsudolab/loop-engineering.git",
    "directory": "tools/loop-cost"
  },
  "homepage": "https://github.com/mitsudolab/loop-engineering/tree/main/tools/loop-cost",
  "bugs": {
    "url": "https://github.com/mitsudolab/loop-engineering/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "loopEngineering": {
    "packageBoundary": {
      "workspace": "tools/loop-cost",
      "publishedPackage": "@cobusgreyling/loop-cost",
      "supportedUsage": [
        "install from npm as a standalone CLI",
        "run with bundled registry data for local estimation workflows",
        "consume package-level documentation instead of the private monorepo root"
      ],
      "unsupportedUsage": [
        "installing the repository root package as a runtime dependency",
        "treating this package as a browser-facing SDK",
        "assuming write access to repositories or GitHub tokens is required"
      ]
    }
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}